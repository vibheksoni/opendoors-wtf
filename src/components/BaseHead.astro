---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { siteConfig } from '../config/site';
import { buildPersonJsonLd, buildWebSiteJsonLd } from '../utils/jsonLd';
import { LANGUAGES, type Lang } from '../i18n';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata;
	imageAlt?: string;
	canonical?: string;
	ogType?: 'website' | 'article' | 'profile';
	noIndex?: boolean;
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	markdownUrl?: string;
	lang?: Lang;
	alternates?: Array<{ lang: Lang; href: string }>;
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${basePath}${path}`;

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
	imageAlt,
	canonical,
	ogType = 'website',
	noIndex = false,
	publishedTime,
	modifiedTime,
	tags = [],
	markdownUrl,
	lang = 'en',
	alternates = [],
	jsonLd,
} = Astro.props;

const brandedTitle = `${title} | ${siteConfig.title}`;
const pageTitle = title === SITE_TITLE ? SITE_TITLE : brandedTitle.length <= 65 ? brandedTitle : title;
const canonicalHref = canonical ?? canonicalURL.toString();
const ogImage = image?.src
	? new URL(image.src, Astro.site).toString()
	: new URL(siteConfig.defaults.ogImage, Astro.site).toString();
const ogImageWidth = image?.width ?? siteConfig.defaults.ogImageWidth;
const ogImageHeight = image?.height ?? siteConfig.defaults.ogImageHeight;
const ogImageAlt = imageAlt ?? (image ? title : siteConfig.defaults.ogImageAlt);
const robots = noIndex
	? 'noindex,follow'
	: 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
const pageJsonLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const hasWebSite = pageJsonLd.some((block) => block['@type'] === 'WebSite');
const jsonLdBlocks = [
	buildPersonJsonLd(),
	...(hasWebSite ? [] : [buildWebSiteJsonLd(siteConfig.site, siteConfig.title, SITE_DESCRIPTION)]),
	...pageJsonLd,
];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
<link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png')} />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
<link rel="manifest" href={withBase('/site.webmanifest')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<link rel="alternate" type="text/plain" title="OpenDoors for LLMs" href={new URL('llms.txt', Astro.site)} />
{markdownUrl && <link rel="alternate" type="text/markdown" title={`${title} (Markdown)`} href={markdownUrl} />}
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#050505" />
<meta name="referrer" content="strict-origin-when-cross-origin" />

<link rel="preload" href={withBase('/fonts/atkinson-regular.woff')} as="font" type="font/woff" crossorigin />
<link rel="preload" href={withBase('/fonts/atkinson-bold.woff')} as="font" type="font/woff" crossorigin />
<link rel="preload" href={withBase('/fonts/space-grotesk-latin.woff2')} as="font" type="font/woff2" crossorigin />

<link rel="canonical" href={canonicalHref} />
{alternates.length > 1 ? (
	<>
		{alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
		<link rel="alternate" hreflang="x-default" href={alternates.find((alt) => alt.lang === 'en')?.href ?? canonicalHref} />
	</>
) : (
	<>
		<link rel="alternate" hreflang={lang} href={canonicalHref} />
		<link rel="alternate" hreflang="x-default" href={canonicalHref} />
	</>
)}
<link rel="author" href={siteConfig.author.url} />
<link rel="me" href={siteConfig.sites.portfolio} />
<link rel="me" href={siteConfig.socials.github} />
<link rel="me" href={siteConfig.socials.x} />

<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
<meta name="author" content={siteConfig.author.name} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content={LANGUAGES[lang].locale} />
{alternates.filter((alt) => alt.lang !== lang).map((alt) => <meta property="og:locale:alternate" content={LANGUAGES[alt.lang].locale} />)}
{ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{ogType === 'article' && (modifiedTime ?? publishedTime) && <meta property="article:modified_time" content={(modifiedTime ?? publishedTime)!.toISOString()} />}
{ogType === 'article' && <meta property="article:author" content={siteConfig.author.url} />}
{ogType === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
{ogType === 'profile' && <meta property="profile:username" content="vibheksoni" />}

<meta name="twitter:card" content={siteConfig.defaults.twitterCard} />
<meta name="twitter:url" content={canonicalHref} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
<meta name="twitter:site" content={siteConfig.author.twitter} />
<meta name="twitter:creator" content={siteConfig.author.twitter} />

{jsonLdBlocks.map((block) => (
	<script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
