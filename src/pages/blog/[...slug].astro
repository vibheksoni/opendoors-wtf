---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { postMarkdownUrl, postWordCount } from '../../utils/posts';
import { alternatesFor } from '../../utils/translations';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const alternates = await alternatesFor(post.id);
---

<BlogPost {...post.data} wordCount={postWordCount(post)} markdownUrl={postMarkdownUrl(post)} alternates={alternates}>
	<Content />
</BlogPost>
