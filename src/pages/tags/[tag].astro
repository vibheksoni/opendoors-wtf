---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { siteConfig } from '../../config/site';
import { buildBreadcrumbJsonLd } from '../../utils/jsonLd';
import { sortPosts } from '../../utils/posts';
import { toSlug, toTitle } from '../../utils/tags';

export async function getStaticPaths() {
	const posts = sortPosts(await getCollection('blog'));
	const tags = new Set(posts.flatMap((post) => post.data.tags));

	return Array.from(tags).map((tag) => ({
		params: { tag: toSlug(tag) },
		props: { tag },
	}));
}

const { tag } = Astro.props;
const posts = sortPosts(await getCollection('blog')).filter((post) => post.data.tags.includes(tag));
const pageUrl = new URL(`/tags/${toSlug(tag)}/`, Astro.site ?? siteConfig.site).toString();
const title = `${toTitle(tag)} posts`;
const description = `OpenDoors writeups on ${tag} by ${siteConfig.author.name}. ${posts.length} ${posts.length === 1 ? 'post' : 'posts'} on reverse engineering, security research and backend engineering.`;
const jsonLd = [
	buildBreadcrumbJsonLd([
		{ name: 'Home', url: Astro.site?.toString() ?? siteConfig.site },
		{ name: 'Topics', url: new URL('/tags/', Astro.site ?? siteConfig.site).toString() },
		{ name: toTitle(tag), url: pageUrl },
	]),
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		name: title,
		url: pageUrl,
		about: tag,
		inLanguage: siteConfig.language,
		mainEntity: {
			'@type': 'ItemList',
			itemListElement: posts.map((post, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				url: new URL(`/blog/${post.id}/`, Astro.site ?? siteConfig.site).toString(),
				name: post.data.title,
			})),
		},
	},
];

const basePath = import.meta.env.BASE_URL;
const withBase = (path: string) => {
	const normalized = path.replace(/^\//, '');
	return basePath.endsWith('/') ? `${basePath}${normalized}` : `${basePath}/${normalized}`;
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} noIndex={posts.length < 2} jsonLd={jsonLd} />
	</head>
	<body>
		<Header />
		<main>
			<p class="crumb"><a href={withBase('/tags/')}>Topics</a></p>
			<h1>{toTitle(tag)}</h1>
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<a href={withBase(`/blog/${post.id}/`)}>
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
							<span class="date"><FormattedDate date={post.data.pubDate} /></span>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.crumb {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}

	.crumb a {
		color: var(--silver-dim);
		text-decoration: none;
	}

	.crumb a:hover {
		color: var(--accent);
	}

	.post-list {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
	}

	.post-list li {
		border-top: 1px solid var(--border-subtle);
	}

	.post-list a {
		display: block;
		padding: 1.5rem 0;
		text-decoration: none;
		color: inherit;
	}

	.post-list h2 {
		margin: 0 0 0.5rem;
		font-size: 1.35rem;
		color: var(--text-main);
		transition: color 0.15s;
	}

	.post-list a:hover h2 {
		color: var(--accent);
	}

	.post-list p {
		margin: 0 0 0.75rem;
		color: var(--text-muted);
	}

	.date {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--silver-dim);
	}
</style>
