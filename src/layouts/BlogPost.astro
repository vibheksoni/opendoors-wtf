---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { siteConfig } from '../config/site';
import { buildBlogPostingJsonLd, buildBreadcrumbJsonLd } from '../utils/jsonLd';
import { sortPosts } from '../utils/posts';
import { toSlug, toTitle } from '../utils/tags';
import authorPhoto from '../assets/vibhek-soni.jpg';
import { LANGUAGES, t, type Lang } from '../i18n';

type Props = CollectionEntry<'blog'>['data'] & {
	wordCount?: number;
	markdownUrl?: string;
	lang?: Lang;
	alternates?: Array<{ lang: Lang; href: string }>;
	originalUrl?: string;
	postId?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags,
	canonical,
	wordCount,
	markdownUrl,
	lang = 'en',
	alternates = [],
	originalUrl,
	postId,
} = Astro.props;
const project = postId ? siteConfig.projects.find((entry) => entry.posts.includes(postId)) : undefined;
const allPosts = lang === 'en' && postId ? sortPosts(await getCollection('blog')) : [];
const related = allPosts
	.filter((post) => post.id !== postId)
	.map((post) => ({
		post,
		score:
			post.data.tags.filter((tag) => tags.includes(tag)).length +
			(project && project.posts.includes(post.id) ? 3 : 0),
	}))
	.sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
	.slice(0, 3)
	.map(({ post }) => post);
const strings = t(lang);
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const heroUrl = new URL(heroImage ? heroImage.src : siteConfig.defaults.ogImage, Astro.site).toString();
const breadcrumb = buildBreadcrumbJsonLd([
	{ name: 'Home', url: Astro.site?.toString() ?? siteConfig.site },
	{ name: 'Blog', url: new URL(lang === 'en' ? '/blog/' : `/${lang}/blog/`, Astro.site ?? siteConfig.site).toString() },
	{ name: title, url: pageUrl },
]);
const blogJsonLd = buildBlogPostingJsonLd({
	title,
	description,
	url: pageUrl,
	image: heroUrl,
	datePublished: pubDate.toISOString(),
	dateModified: updatedDate?.toISOString(),
	keywords: tags,
	wordCount,
	markdownUrl,
	lang,
	originalUrl,
	about: project ? { name: project.name, url: project.url } : undefined,
});

const basePath = import.meta.env.BASE_URL;
const withBase = (path: string) => {
	const normalized = path.replace(/^\//, '');
	return basePath.endsWith('/') ? `${basePath}${normalized}` : `${basePath}/${normalized}`;
};
---

<html lang={lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			ogType="article"
			canonical={canonical}
			lang={lang}
			alternates={alternates}
			publishedTime={pubDate}
			modifiedTime={updatedDate}
			tags={tags}
			markdownUrl={markdownUrl}
			jsonLd={[breadcrumb, blogJsonLd]}
		/>
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding-bottom: 1rem;
			}
			.hero-image {
				width: 100%;
				max-width: 1020px;
				margin: 0 auto 2rem;
				padding: 0 1rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 16px;
				box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5);
				border: 1px solid var(--border-subtle);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--text-muted);
			}
			.title {
				margin-bottom: 0;
				padding: 0;
				text-align: center;
				line-height: 1;
			}
			.title hr {
				margin: 2.5rem 0 0;
			}
			.title + :global(*) {
				margin-top: 2.5rem;
			}
			.title h1 {
				margin: 0.5em 0;
				color: #fff;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--text-muted);
				font-size: 0.95rem;
			}
			.last-updated-on {
				font-style: italic;
				font-size: 0.9em;
				opacity: 0.8;
			}
			.tag-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem 1.25rem;
				justify-content: center;
				margin: 1.25rem 0 0;
				padding: 0;
				list-style: none;
				font-family: var(--font-mono);
				font-size: 0.8rem;
			}
			.tag-list a {
				color: var(--silver-dim);
				text-decoration: none;
			}
			.tag-list a::before {
				content: '#';
				color: var(--accent);
				margin-right: 0.15rem;
			}
			.tag-list a:hover {
				color: var(--accent);
			}
			.lang-switch {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.35rem 1rem;
				margin-top: 1rem;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--silver-dim);
			}
			.lang-switch a {
				color: var(--silver-dim);
				text-decoration: none;
			}
			.lang-switch a:hover {
				color: var(--accent);
			}
			.lang-switch .current {
				color: var(--accent);
			}
			.translated-note {
				margin: 0.75rem 0 0;
				font-size: 0.85rem;
				color: var(--silver-dim);
			}
			.author-box {
				display: flex;
				gap: 1.25rem;
				align-items: flex-start;
				margin-top: 4rem;
				padding-top: 2rem;
				border-top: 1px solid var(--border-subtle);
			}
			.author-photo {
				width: 64px;
				height: 64px;
				border-radius: 50%;
				object-fit: cover;
				object-position: 50% 30%;
				flex-shrink: 0;
			}
			.author-box p {
				margin: 0 0 0.5rem;
			}
			.author-name {
				color: var(--text-main);
				font-weight: 600;
			}
			.author-name a {
				color: var(--text-main);
			}
			.author-bio {
				color: var(--text-muted);
				font-size: 0.95rem;
			}
			.author-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25rem 1rem;
				font-family: var(--font-mono);
				font-size: 0.8rem;
			}
			.author-links a {
				color: var(--silver-dim);
				text-decoration: none;
			}
			.author-links a:hover,
			.support a:hover {
				color: var(--accent);
			}
			.support {
				font-size: 0.9rem;
				color: var(--text-muted);
			}
			.support a {
				color: var(--accent);
			}
			.open-to-work {
				font-size: 0.95rem;
				color: var(--text-main);
			}
			.open-to-work a {
				color: var(--accent);
			}
			.project-card {
				margin-top: 4rem;
				padding: 1.5rem 1.75rem;
				border: 1px solid var(--border-subtle);
				border-radius: 14px;
				background: rgba(255, 255, 255, 0.02);
			}
			.project-card p {
				margin: 0 0 0.5rem;
			}
			.project-label,
			.related-title {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--silver-dim);
			}
			.project-name {
				font-size: 1.25rem;
				font-weight: 600;
			}
			.project-name a {
				color: var(--text-main);
				text-decoration: none;
			}
			.project-name a:hover {
				color: var(--accent);
			}
			.project-summary {
				color: var(--text-muted);
				font-size: 0.95rem;
			}
			.project-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1.25rem;
				margin-top: 0.75rem !important;
				font-family: var(--font-mono);
				font-size: 0.85rem;
			}
			.project-links a {
				color: var(--accent);
				text-decoration: none;
			}
			.project-links a:hover {
				text-decoration: underline;
			}
			.project-card + .author-box {
				margin-top: 2.5rem;
			}
			.related {
				margin-top: 3rem;
				padding-top: 2rem;
				border-top: 1px solid var(--border-subtle);
			}
			.related ul {
				list-style: none;
				margin: 1rem 0 0;
				padding: 0;
				display: grid;
				gap: 0.75rem;
			}
			.related a {
				display: block;
				padding: 1rem 1.25rem;
				border: 1px solid var(--border-subtle);
				border-radius: 12px;
				text-decoration: none;
				transition: border-color 0.2s ease;
			}
			.related a:hover {
				border-color: var(--border-hover);
			}
			.related-name {
				display: block;
				color: var(--text-main);
				font-weight: 600;
				margin-bottom: 0.25rem;
			}
			.related-desc {
				display: block;
				color: var(--text-muted);
				font-size: 0.9rem;
				line-height: 1.5;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<figure class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt={title} />
					</figure>
				)}
				<div class="prose">
					<header class="title">
						<div class="date">
							<FormattedDate date={pubDate} locale={LANGUAGES[lang].dateLocale} />
							{
								updatedDate && (
									<div class="last-updated-on">
										{strings.updated} <FormattedDate date={updatedDate} locale={LANGUAGES[lang].dateLocale} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{tags?.length ? (
							<ul class="tag-list">
								{tags.map((tag) => (
									<li>
										<a href={withBase(`/tags/${toSlug(tag)}/`)}>{toTitle(tag)}</a>
									</li>
								))}
							</ul>
						) : null}
						{alternates.length > 1 && (
							<nav class="lang-switch" aria-label={strings.readIn}>
								<span>{strings.readIn}</span>
								{alternates.map((alt) =>
									alt.lang === lang ? (
										<span class="current" aria-current="page">{LANGUAGES[alt.lang].name}</span>
									) : (
										<a href={alt.href} hreflang={alt.lang} lang={alt.lang}>{LANGUAGES[alt.lang].name}</a>
									),
								)}
							</nav>
						)}
						{originalUrl && (
							<p class="translated-note">{strings.translatedFrom} <a href={originalUrl} hreflang="en">English</a>.</p>
						)}
						<hr />
					</header>
					<slot />
					{lang === 'en' && project && (
						<aside class="project-card" aria-label={`About ${project.name}`}>
							<p class="project-label">The project</p>
							<p class="project-name"><a href={project.url} target="_blank" rel="noreferrer">{project.name}</a></p>
							<p class="project-summary">{project.summary}</p>
							<p class="project-links">
								{project.links.map((link) => (
									<a href={link.url} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
								))}
								<a href={withBase('/projects/')}>All projects</a>
							</p>
						</aside>
					)}
					<aside class="author-box" aria-label="About the author">
						<Image src={authorPhoto} alt="Vibhek Soni" width={128} height={128} class="author-photo" />
						<div>
							<p class="author-name">{strings.writtenBy} <a href={siteConfig.author.url} rel="author">{siteConfig.author.name}</a></p>
							<p class="author-bio">{strings.bio}</p>
							<p class="author-links">
								<a href={siteConfig.socials.github} rel="me noreferrer" target="_blank">GitHub</a>
								<a href={siteConfig.socials.x} rel="me noreferrer" target="_blank">X</a>
								<a href={siteConfig.socials.linkedin} rel="me noreferrer" target="_blank">LinkedIn</a>
								<a href={`mailto:${siteConfig.author.email}`}>{strings.email}</a>
								{markdownUrl && <a href={markdownUrl}>{strings.readMarkdown}</a>}
							</p>
							{lang === 'en' && (
								<p class="open-to-work">I'm open to backend, AI infrastructure and security roles. Reach me at <a href={`mailto:${siteConfig.author.email}`}>{siteConfig.author.email}</a>.</p>
							)}
							<p class="support">{strings.support} <a href={siteConfig.socials.buymeacoffee} target="_blank" rel="noreferrer">{strings.coffee}</a> {strings.or} <a href={siteConfig.socials.devagency} target="_blank" rel="noreferrer">{strings.work}</a>.</p>
						</div>
					</aside>
					{related.length > 0 && (
						<nav class="related" aria-label="Keep reading">
							<p class="related-title">Keep reading</p>
							<ul>
								{related.map((post) => (
									<li>
										<a href={withBase(`/blog/${post.id}/`)}>
											<span class="related-name">{post.data.title}</span>
											<span class="related-desc">{post.data.description}</span>
										</a>
									</li>
								))}
							</ul>
						</nav>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
