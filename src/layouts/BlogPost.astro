---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { siteConfig } from '../config/site';
import { buildBlogPostingJsonLd, buildBreadcrumbJsonLd } from '../utils/jsonLd';
import { toSlug, toTitle } from '../utils/tags';
import authorPhoto from '../assets/vibhek-soni.jpg';

type Props = CollectionEntry<'blog'>['data'] & { wordCount?: number; markdownUrl?: string };

const { title, description, pubDate, updatedDate, heroImage, tags, canonical, wordCount, markdownUrl } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const heroUrl = new URL(heroImage ? heroImage.src : siteConfig.defaults.ogImage, Astro.site).toString();
const breadcrumb = buildBreadcrumbJsonLd([
	{ name: 'Home', url: Astro.site?.toString() ?? siteConfig.site },
	{ name: 'Blog', url: new URL('/blog/', Astro.site ?? siteConfig.site).toString() },
	{ name: title, url: pageUrl },
]);
const blogJsonLd = buildBlogPostingJsonLd({
	title,
	description,
	url: pageUrl,
	image: heroUrl,
	datePublished: pubDate.toISOString(),
	dateModified: updatedDate?.toISOString(),
	keywords: tags,
	wordCount,
	markdownUrl,
});

const basePath = import.meta.env.BASE_URL;
const withBase = (path: string) => {
	const normalized = path.replace(/^\//, '');
	return basePath.endsWith('/') ? `${basePath}${normalized}` : `${basePath}/${normalized}`;
};
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			ogType="article"
			canonical={canonical}
			publishedTime={pubDate}
			modifiedTime={updatedDate}
			tags={tags}
			markdownUrl={markdownUrl}
			jsonLd={[breadcrumb, blogJsonLd]}
		/>
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				/* Padding is handled in global.css, but we might need extra for the hero image */
			}
			.hero-image {
				width: 100%;
				max-width: 1020px;
				margin: 0 auto 2rem;
				padding: 0 1rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 16px;
				box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5);
				border: 1px solid var(--border-subtle);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--text-muted);
			}
			.title {
				margin-bottom: 2em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0.5em 0;
				color: #fff;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--text-muted);
				font-size: 0.95rem;
			}
			.last-updated-on {
				font-style: italic;
				font-size: 0.9em;
				opacity: 0.8;
			}
			.tag-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem 1.25rem;
				justify-content: center;
				margin: 1.25rem 0 0;
				padding: 0;
				list-style: none;
				font-family: var(--font-mono);
				font-size: 0.8rem;
			}
			.tag-list a {
				color: var(--silver-dim);
				text-decoration: none;
			}
			.tag-list a::before {
				content: '#';
				color: var(--accent);
				margin-right: 0.15rem;
			}
			.tag-list a:hover {
				color: var(--accent);
			}
			.author-box {
				display: flex;
				gap: 1.25rem;
				align-items: flex-start;
				margin-top: 4rem;
				padding-top: 2rem;
				border-top: 1px solid var(--border-subtle);
			}
			.author-photo {
				width: 64px;
				height: 64px;
				border-radius: 50%;
				object-fit: cover;
				object-position: 50% 30%;
				flex-shrink: 0;
			}
			.author-box p {
				margin: 0 0 0.5rem;
			}
			.author-name {
				color: var(--text-main);
				font-weight: 600;
			}
			.author-name a {
				color: var(--text-main);
			}
			.author-bio {
				color: var(--text-muted);
				font-size: 0.95rem;
			}
			.author-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25rem 1rem;
				font-family: var(--font-mono);
				font-size: 0.8rem;
			}
			.author-links a {
				color: var(--silver-dim);
				text-decoration: none;
			}
			.author-links a:hover,
			.support a:hover {
				color: var(--accent);
			}
			.support {
				font-size: 0.9rem;
				color: var(--text-muted);
			}
			.support a {
				color: var(--accent);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<figure class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={title} />}
				</figure>
				<div class="prose">
					<header class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{tags?.length ? (
							<ul class="tag-list">
								{tags.map((tag) => (
									<li>
										<a href={withBase(`/tags/${toSlug(tag)}/`)}>{toTitle(tag)}</a>
									</li>
								))}
							</ul>
						) : null}
						<hr />
					</header>
					<slot />
					<aside class="author-box" aria-label="About the author">
						<Image src={authorPhoto} alt="Vibhek Soni" width={128} height={128} class="author-photo" />
						<div>
							<p class="author-name">Written by <a href={siteConfig.author.url} rel="author">{siteConfig.author.name}</a></p>
							<p class="author-bio">{siteConfig.author.bio}</p>
							<p class="author-links">
								<a href={siteConfig.socials.github} rel="me noreferrer" target="_blank">GitHub</a>
								<a href={siteConfig.socials.x} rel="me noreferrer" target="_blank">X</a>
								<a href={siteConfig.socials.linkedin} rel="me noreferrer" target="_blank">LinkedIn</a>
								<a href={`mailto:${siteConfig.author.email}`}>Email</a>
								{markdownUrl && <a href={markdownUrl}>Read as Markdown</a>}
							</p>
							<p class="support">If this helped you, you can <a href={siteConfig.socials.buymeacoffee} target="_blank" rel="noreferrer">buy me a coffee</a>, or <a href={siteConfig.socials.devagency} target="_blank" rel="noreferrer">work with me through DevHive Studios</a>.</p>
						</div>
					</aside>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
